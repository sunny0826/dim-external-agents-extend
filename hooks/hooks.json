{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context.js\"",
            "timeout": 5,
            "statusMessage": "检查外部 Agent 状态…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/on-post-tool.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/on-stop.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
